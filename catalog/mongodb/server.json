{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.mongodb-js/mongodb",
  "title": "MongoDB",
  "description": "Stdio MCP server for MongoDB.",
  "version": "3.1.0",
  "repository": {
    "url": "https://github.com/mongodb-js/mongodb-mcp-server",
    "source": "github"
  },
  "websiteUrl": "https://github.com/mongodb-js/mongodb-mcp-server",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "mongodb-mcp-server",
      "version": "3.1.0",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "named",
          "name": "--readOnly"
        }
      ],
      "environmentVariables": [
        {
          "name": "MDB_MCP_CONNECTION_STRING",
          "description": "Inherited from the host environment: MDB_MCP_CONNECTION_STRING.",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}
