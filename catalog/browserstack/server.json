{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.browserstack/mcp-server",
  "title": "BrowserStack",
  "description": "Stdio MCP server for BrowserStack.",
  "version": "2.2.8",
  "repository": {
    "url": "https://github.com/browserstack/mcp-server",
    "source": "github"
  },
  "websiteUrl": "https://github.com/browserstack/mcp-server",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@browserstack/mcp-server",
      "version": "2.2.8",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "BROWSERSTACK_USERNAME",
          "description": "Inherited from the host environment: BROWSERSTACK_USERNAME.",
          "isRequired": true,
          "isSecret": false
        },
        {
          "name": "BROWSERSTACK_ACCESS_KEY",
          "description": "Inherited from the host environment: BROWSERSTACK_ACCESS_KEY.",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}
