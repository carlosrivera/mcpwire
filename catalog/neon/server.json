{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.neondatabase/mcp-server-neon",
  "title": "Neon",
  "description": "Stdio MCP server for Neon.",
  "version": "0.6.5",
  "repository": {
    "url": "https://github.com/neondatabase/mcp-server-neon",
    "source": "github"
  },
  "websiteUrl": "https://github.com/neondatabase/mcp-server-neon",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@neondatabase/mcp-server-neon",
      "version": "0.6.5",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "NEON_API_KEY",
          "description": "Inherited from the host environment: NEON_API_KEY.",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}
