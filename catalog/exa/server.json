{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.exa/exa-mcp-server",
  "title": "Exa",
  "description": "Stdio MCP server for Exa.",
  "version": "3.4.2",
  "repository": {
    "url": "https://github.com/exa-labs/exa-mcp-server",
    "source": "github"
  },
  "websiteUrl": "https://github.com/exa-labs/exa-mcp-server",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "exa-mcp-server",
      "version": "3.4.2",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "EXA_API_KEY",
          "description": "Inherited from the host environment: EXA_API_KEY.",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}
