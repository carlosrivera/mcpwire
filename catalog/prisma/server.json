{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.prisma/prisma-mcp",
  "title": "Prisma",
  "description": "Stdio MCP server for Prisma.",
  "version": "7.10.1",
  "repository": {
    "url": "https://github.com/prisma/prisma",
    "source": "github"
  },
  "websiteUrl": "https://github.com/prisma/prisma",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "prisma",
      "version": "7.10.1",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}
