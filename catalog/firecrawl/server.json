{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.firecrawl/firecrawl-mcp",
  "title": "Firecrawl",
  "description": "Stdio MCP server for Firecrawl.",
  "version": "3.35.0",
  "repository": {
    "url": "https://github.com/firecrawl/firecrawl-mcp-server",
    "source": "github"
  },
  "websiteUrl": "https://github.com/firecrawl/firecrawl-mcp-server",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "firecrawl-mcp",
      "version": "3.35.0",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "FIRECRAWL_API_KEY",
          "description": "Inherited from the host environment: FIRECRAWL_API_KEY.",
          "isRequired": true,
          "isSecret": true
        },
        {
          "name": "FIRECRAWL_API_URL",
          "description": "Inherited from the host environment: FIRECRAWL_API_URL.",
          "isRequired": false,
          "isSecret": false
        }
      ]
    }
  ]
}
