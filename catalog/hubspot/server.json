{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.hubspot/mcp-server",
  "title": "HubSpot",
  "description": "Stdio MCP server for HubSpot.",
  "version": "0.4.0",
  "websiteUrl": "https://www.npmjs.com/package/@hubspot/mcp-server",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@hubspot/mcp-server",
      "version": "0.4.0",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "PRIVATE_APP_ACCESS_TOKEN",
          "description": "Inherited from the host environment: PRIVATE_APP_ACCESS_TOKEN.",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}
