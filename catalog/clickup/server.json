{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.nsxdavid/clickup-mcp-server",
  "title": "ClickUp",
  "description": "Stdio MCP server for ClickUp.",
  "version": "1.12.0",
  "repository": {
    "url": "https://github.com/nsxdavid/clickup-mcp-server",
    "source": "github"
  },
  "websiteUrl": "https://github.com/nsxdavid/clickup-mcp-server",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "clickup-mcp-server",
      "version": "1.12.0",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "CLICKUP_API_TOKEN",
          "description": "Inherited from the host environment: CLICKUP_API_TOKEN.",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}
