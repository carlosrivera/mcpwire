{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.postmanlabs/postman-mcp-server",
  "title": "Postman",
  "description": "Stdio MCP server for Postman.",
  "version": "2.14.0",
  "repository": {
    "url": "https://github.com/postmanlabs/postman-mcp-server",
    "source": "github"
  },
  "websiteUrl": "https://github.com/postmanlabs/postman-mcp-server",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@postman/postman-mcp-server",
      "version": "2.14.0",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "POSTMAN_API_KEY",
          "description": "Inherited from the host environment: POSTMAN_API_KEY.",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}
