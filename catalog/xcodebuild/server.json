{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.sentry/xcodebuildmcp",
  "title": "XcodeBuild",
  "description": "Stdio MCP server for XcodeBuild.",
  "version": "2.7.0",
  "repository": {
    "url": "https://github.com/getsentry/XcodeBuildMCP",
    "source": "github"
  },
  "websiteUrl": "https://www.xcodebuildmcp.com",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "xcodebuildmcp",
      "version": "2.7.0",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}
