{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.domdomegg/airtable-mcp-server",
  "title": "Airtable",
  "description": "Stdio MCP server for Airtable.",
  "version": "1.14.0",
  "repository": {
    "url": "https://github.com/domdomegg/airtable-mcp-server",
    "source": "github"
  },
  "websiteUrl": "https://github.com/domdomegg/airtable-mcp-server",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "airtable-mcp-server",
      "version": "1.14.0",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "AIRTABLE_API_KEY",
          "description": "Inherited from the host environment: AIRTABLE_API_KEY.",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}
