{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.markuspfundstein/mcp-obsidian",
  "title": "Obsidian",
  "description": "Stdio MCP server for Obsidian.",
  "version": "0.2.3",
  "repository": {
    "url": "https://github.com/MarkusPfundstein/mcp-obsidian",
    "source": "github"
  },
  "websiteUrl": "https://github.com/MarkusPfundstein/mcp-obsidian",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "mcp-obsidian",
      "version": "0.2.3",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "OBSIDIAN_API_KEY",
          "description": "Inherited from the host environment: OBSIDIAN_API_KEY.",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}
