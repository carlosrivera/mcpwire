{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.redis/redis",
  "title": "Redis",
  "description": "Stdio MCP server for Redis.",
  "version": "0.5.1",
  "repository": {
    "url": "https://github.com/redis/mcp-redis",
    "source": "github"
  },
  "websiteUrl": "https://redis.io/docs/latest/integrate/redis-mcp/install/",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "redis-mcp-server",
      "version": "0.5.1",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "named",
          "name": "--url",
          "value": "{redis_url}",
          "variables": {
            "redis_url": {
              "description": "Redis URL reachable from the host",
              "format": "string",
              "isRequired": true
            }
          }
        }
      ]
    }
  ]
}
