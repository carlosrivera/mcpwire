{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.snyk/cli-mcp",
  "title": "Snyk",
  "description": "Stdio MCP server for Snyk.",
  "version": "1.1308.3",
  "repository": {
    "url": "https://github.com/snyk/cli",
    "source": "github"
  },
  "websiteUrl": "https://github.com/snyk/cli",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "snyk",
      "version": "1.1308.3",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "SNYK_TOKEN",
          "description": "Inherited from the host environment: SNYK_TOKEN.",
          "isRequired": false,
          "isSecret": true
        }
      ],
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}
