{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MCPWire catalog policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "slug",
    "category",
    "source",
    "icon",
    "tagline",
    "requirements",
    "inputs",
    "defaults",
    "tools"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "enum": [
        "official",
        "community"
      ]
    },
    "icon": {
      "type": "string",
      "pattern": "^/icons/[a-z0-9-]+\\.svg$"
    },
    "tagline": {
      "type": "string",
      "minLength": 1
    },
    "requirements": {
      "type": "string",
      "minLength": 1
    },
    "inputs": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "example"
        ],
        "properties": {
          "example": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allow",
        "redactSecrets",
        "ttl"
      ],
      "properties": {
        "allow": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+$"
          }
        },
        "redactSecrets": {
          "type": "boolean"
        },
        "ttl": {
          "type": "string",
          "pattern": "^(?:[1-9][0-9]*|(?:[0-9]+(?:ms|s|m|h))+)$"
        }
      }
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "risk",
          "note"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+$"
          },
          "risk": {
            "enum": [
              "safe",
              "caution",
              "high"
            ]
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "seo": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    }
  }
}
