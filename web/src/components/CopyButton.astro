---
interface Props {
  text: string;
  label: string;
  id?: string;
}
const { text, label, id } = Astro.props;
---

<button id={id} type="button" data-copy={text} aria-label={label} title={label}>
  <svg class="copy-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="8" y="8" width="12" height="12" rx="2"/><path d="M16 8V4H4v12h4"/></svg>
  <svg class="copy-check" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 4 4L19 6"/></svg>
  <span class="home-copy-status" role="status" aria-live="polite"></span>
</button>
