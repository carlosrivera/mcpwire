---
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const inGuides = currentPath.startsWith('/teleport');
---
<header class="site-header">
  <div class="site-nav site-width">
    <a href="/" class="site-wordmark" aria-label="MCPWire home">mcpwire<span>.</span></a>
    <button class="site-menu-toggle" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="site-menu"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path class="menu-lines" d="M4 8h16M4 16h16"/><path class="menu-close" d="m6 6 12 12M6 18 18 6"/></svg></button>
    <nav id="site-menu" aria-label="Main navigation"><a href="/docs/" aria-current={currentPath === "/docs" ? "page" : undefined}>Docs</a><a href="/teleport/" aria-current={inGuides ? 'location' : undefined}>Server guides</a><a href="https://github.com/carlosrivera/mcpwire" class="site-source"><img src="/icons/github.svg" alt="" width="18" height="18" />Source <span aria-hidden="true">↗</span></a></nav>
  </div>
</header>
<script>
  const header = document.querySelector<HTMLElement>('.site-header')!;
  const toggle = header.querySelector<HTMLButtonElement>('.site-menu-toggle')!;
  const menu = header.querySelector<HTMLElement>('#site-menu')!;
  const setOpen = (open:boolean) => {
    toggle.setAttribute('aria-expanded',String(open));
    toggle.setAttribute('aria-label',open ? 'Close navigation' : 'Open navigation');
    header.dataset.menuOpen = String(open);
  };
  header.dataset.navReady = '';
  toggle.addEventListener('click',() => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  header.addEventListener('keydown',event => {
    if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
      toggle.focus();
    }
  });
  document.addEventListener('pointerdown',event => {
    if (!header.contains(event.target as Node)) setOpen(false);
  });
  header.addEventListener('focusout',event => {
    if (!header.contains(event.relatedTarget as Node)) setOpen(false);
  });
  menu.addEventListener('click',event => {
    if ((event.target as HTMLElement).closest('a')) setOpen(false);
  });
  window.matchMedia('(max-width:680px)').addEventListener('change',() => setOpen(false));
</script>
