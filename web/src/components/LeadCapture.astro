---
// B2B lead capture. No backend, no cookies: composes a mailto so the static
// site stays $0-forever. Swap the action for Formspree/Workers later if wanted.
const id = `lead-${Math.random().toString(36).slice(2, 8)}`;
---

<div class="lead panel" id={id}>
  <div class="panel-body">
    <div class="lead-title">A shared workspace for your tools.</div>
    <p class="dim">
      We’re exploring persistent namespaces, identity verification and shared audit logs. Get in touch about Team Mesh early access.
    </p>
    <form>
      <div class="row">
        <input type="email" name="email" placeholder="enter work email" required aria-label="Work email" />
        <button class="btn" type="submit">Get in touch →</button>
      </div>
      <div class="note faint" data-note></div>
    </form>
  </div>
</div>

<script define:vars={{ id }}>
  const root = document.getElementById(id);
  const form = root.querySelector('form');
  const note = root.querySelector('[data-note]');
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const email = form.email.value.trim();
    if (!email) return;
    const subject = encodeURIComponent('Team Mesh early access request');
    const body = encodeURIComponent(
      `Hi MCPWire,\n\nPlease add me to the Enterprise & Team Mesh early access list.\n\nWork email: ${email}\nTeam size / use case: \n\n— sent from mcpwire.co`,
    );
    window.location.href = `mailto:earlyaccess@mcpwire.co?subject=${subject}&body=${body}`;
    note.textContent = 'Opening your email client to send your early access request.';
    form.reset();
  });
</script>

<style>
  .lead .panel-body { padding: 26px; }
  .lead-title { font-weight: 550; font-size: 20px; margin-bottom: 10px; color: var(--text); }
  .lead .row { display: flex; gap: 12px; margin-top: 14px; flex-wrap: wrap; }
  .lead input[type='email'] { flex: 1; min-width: min(220px, 100%); }
  .lead .note { margin-top: 10px; min-height: 1.2em; }
</style>
