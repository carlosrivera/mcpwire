---
import Base from '../../layouts/Base.astro';
import CopyButton from '../../components/CopyButton.astro';
import { Code } from 'astro:components';
import servers from '../../data/servers';
import { SITE_URL, canonicalURL, serverSEO } from '../../data/seo.mjs';

export function getStaticPaths() {
  return servers.map((server) => ({ params: { slug: server.slug }, props: { server } }));
}

const s = Astro.props.server;
const defaults = s.tools.filter((tool) => s.defaults.allow.includes(tool.name));
const caution = s.tools.filter((tool) => !s.defaults.allow.includes(tool.name) && tool.risk !== 'high');
const high = s.tools.filter((tool) => !s.defaults.allow.includes(tool.name) && tool.risk === 'high');

const guides = import.meta.glob('../../../../catalog/*/guide.md', { eager: true });
const Guide = (guides[`../../../../catalog/${s.slug}/guide.md`] as { Content?: any } | undefined)?.Content;
if (!Guide) throw new Error(`Missing catalog guide for ${s.slug}`);

const allowArg = defaults.map((tool) => tool.name).join(',');
const shareCmd = [
  'npx -y @mcpwire/cli share',
  `--name ${s.slug}`,
  `--allow "${allowArg}"`,
  ...(s.defaults.redactSecrets ? ['--redact-secrets'] : []),
  `-- ${s.command}`,
].join(' \\\n  ');

const guestJson = JSON.stringify(
  {
    mcpServers: {
      [s.slug]: {
        command: 'npx',
        args: ['-y', '@mcpwire/cli', 'join', 'wire://<TICKET_FROM_HOST>'],
      },
    },
  },
  null,
  2
);

const seo = serverSEO(s);
const canonical = canonicalURL(`/teleport/${s.slug}`);
const related = servers.filter(server => server.slug !== s.slug && server.category === s.category).slice(0,3);
const structuredData = [{
  '@type':'TechArticle', '@id':`${canonical}#guide`, url:canonical,
  headline:`Share ${s.name} MCP tools.`, description:seo.description, inLanguage:'en',
  mainEntityOfPage:{'@id':`${canonical}#webpage`},
  author:{'@id':`${SITE_URL}/#organization`}, publisher:{'@id':`${SITE_URL}/#organization`},
  image:new URL(seo.image,SITE_URL).href,
  articleSection:s.category,
  about:{'@type':'SoftwareApplication',name:`${s.name} MCP server`,url:s.docs,applicationCategory:'DeveloperApplication',softwareVersion:s.packageVersion},
}];
---

<Base {...seo} breadcrumbs={[{name:'Home',path:'/'},{name:'MCP server guides',path:'/teleport'},{name:s.name,path:`/teleport/${s.slug}`}]} structuredData={structuredData}>
  <section class="section">
    <div class="wrap guide-shell">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <a href="/teleport/">Server guides</a>
        <span aria-hidden="true">/</span>
        <span>{s.name}</span>
      </nav>

      <!-- Server Hero Header -->
      <header class="guide-header">
        <div class="guide-header-top">
          <div class="guide-icon-box">
            <img src={s.icon} alt="" width="48" height="48" />
          </div>
          <div>
            <div class="guide-badges">
              <span class="tag">{s.category}</span>
              <span class="tag">{s.source} server</span>
              <span class="badge safe">{defaults.length} {defaults.length === 1 ? 'tool' : 'tools'} enabled</span>
              {caution.length + high.length > 0 && (
                <span class="badge warn">{caution.length + high.length} tools restricted</span>
              )}
            </div>
            <h1>Share {s.name} MCP tools.</h1>
          </div>
        </div>
        <p class="page-intro">{s.tagline}</p>
      </header>

      <!-- Prerequisites (if any) -->
      {(s.requirements || s.docs) && (
        <aside class="card prerequisites">
          <div class="prereq-icon" aria-hidden="true">⚡</div>
          <div class="prereq-content">
            <strong>Host setup & prerequisites</strong>
            {s.requirements && <p>{s.requirements}</p>}
            {s.docs && (
              <a href={s.docs} target="_blank" rel="noopener noreferrer">
                {s.name} server documentation <span aria-hidden="true">↗</span>
              </a>
            )}
          </div>
        </aside>
      )}

      <!-- Step 1: Host Command -->
      <section class="step-card">
        <div class="step-heading">
          <span class="step-badge">1</span>
          <div>
            <h2>Run on your machine</h2>
            <p>Start the server on your host machine. Tools not listed in <code class="inline">--allow</code> are completely hidden from the agent.</p>
          </div>
        </div>
        <div class="panel code-panel">
          <div class="panel-head">
            <span class="panel-title">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m5 6 6 6-6 6m9 0h6"/></svg>
              Terminal · Host machine
            </span>
            <CopyButton text={shareCmd} label="Copy host command" />
          </div>
          <Code code={shareCmd} lang="bash" theme="github-dark-dimmed" />
          <div class="panel-body">
            <p class="faint">
              Exposes {defaults.length} default tools with pattern-based secret redaction.
              Optionally set an expiry with <code class="inline">--ttl 30m</code>, prompt for approvals with <code class="inline">--confirm</code>, or limit calls with <code class="inline">--max-calls 20</code>.
            </p>
          </div>
        </div>
      </section>

      <!-- Step 2: Teammate Client Config -->
      <section class="step-card">
        <div class="step-heading">
          <span class="step-badge">2</span>
          <div>
            <h2>Connect your teammate’s agent</h2>
            <p>MCPWire prints a unique <code class="inline">wire://...</code> ticket in your terminal. Send it privately to your teammate to paste into their MCP client:</p>
          </div>
        </div>
        <div class="panel code-panel">
          <div class="panel-head">
            <span class="panel-title">
              <img src="/icons/mcp.svg" alt="" width="15" height="15" />
              Claude Desktop · Cursor · Windsurf config
            </span>
            <CopyButton text={guestJson} label="Copy guest config template" />
          </div>
          <Code code={guestJson} lang="json" theme="github-dark-dimmed" />
          <div class="panel-body">
            <p class="faint">
              Replace <code class="inline">&lt;TICKET_FROM_HOST&gt;</code> with the active session ticket. The agent can only discover and call the tools exposed above.
            </p>
          </div>
        </div>
      </section>

      <!-- Step 3: Tool Access Breakdown (Full Width) -->
      <section class="step-card">
        <div class="step-heading">
          <span class="step-badge">3</span>
          <div>
            <h2>Scoped tool permissions</h2>
            <p>MCPWire acts as a Layer 7 JSON-RPC firewall. Requests for blocked tools are dropped on the wire before ever touching your machine.</p>
          </div>
        </div>
        <div class="panel table-panel">
          <div class="table-scroll" role="region" aria-label={`${s.name} tool access`} tabindex="0">
            <table class="tbl risk-table">
              <thead>
                <tr>
                  <th style="width: 250px;">Tool</th>
                  <th style="width: 170px;">Default Policy</th>
                  <th>Notes</th>
                </tr>
              </thead>
              <tbody>
                {s.tools.map((tool) => {
                  const isAllowed = s.defaults.allow.includes(tool.name);
                  const badgeClass = isAllowed ? 'safe' : tool.risk === 'high' ? 'risk' : 'warn';
                  const badgeLabel = isAllowed ? 'Allowed' : tool.risk === 'high' ? 'Blocked (High risk)' : 'Blocked (Review)';
                  return (
                    <tr>
                      <td><code>{tool.name}</code></td>
                      <td><span class:list={['badge', badgeClass]}>{badgeLabel}</span></td>
                      <td class="dim">{tool.note}</td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
          <div class="table-footer">
            <span>Need different tools?</span>
            <a href={`/builder/?server=${s.slug}`}>Customize this server in the Command Builder <span aria-hidden="true">→</span></a>
          </div>
        </div>
      </section>

      <!-- Step 4: Verification / Testing Guide -->
      <section class="step-card">
        <div class="step-heading">
          <span class="step-badge">4</span>
          <div>
            <h2>Test and verify</h2>
            <p>Try these recommended prompts to confirm the agent receives expected outputs and that restricted actions fail safely.</p>
          </div>
        </div>
        <div class="panel catalog-guide-panel">
          <div class="panel-body catalog-guide">
            <Guide />
          </div>
        </div>
      </section>

      <!-- Audit Callout -->
      <div class="replay-callout card">
        <div class="replay-callout-icon" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        </div>
        <div class="replay-callout-text">
          <strong>Review the session in your browser:</strong>
          <span>Add <code class="inline">--record session.wirelog</code> to your host command. Drop the resulting file into the <a href="/replay/">Session Replay Viewer</a> to inspect timestamps, latency, blocked attempts, and secret scrubbing.</span>
        </div>
      </div>

      {related.length > 0 && <nav class="related-guides" aria-label="Related MCP server guides"><span>Related guides</span>{related.map(server => <a href={`/teleport/${server.slug}/`}>{server.name} MCP <span aria-hidden="true">↗</span></a>)}</nav>}

      <!-- Footer Actions -->
      <div class="page-actions">
        <a class="btn ghost" href="/teleport/">← All server guides</a>
        <a class="btn" href={`/builder/?server=${s.slug}`}>Open in command builder <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
</Base>

<style>
  .related-guides { display:flex; align-items:baseline; flex-wrap:wrap; gap:10px 20px; margin-top:32px; font-size:14px; }
  .related-guides > span { color:var(--text-faint); }
  .related-guides a { color:var(--text-muted); }
  .related-guides a:hover { color:var(--accent); }
  .guide-shell { max-width: 860px; }
  .breadcrumbs { display: flex; gap: 10px; color: var(--text-faint); font-size: 14px; margin-bottom: 28px; }
  .breadcrumbs a:hover { color: var(--accent); }

  .guide-header { margin-bottom: 36px; }
  .guide-header-top { display: flex; align-items: center; gap: 20px; margin-bottom: 16px; }
  .guide-icon-box {
    width: 64px;
    height: 64px;
    border-radius: 14px;
    background: var(--surface);
    display: grid;
    place-items: center;
    flex-shrink: 0;
    box-shadow: var(--shadow-sm);
  }
  .guide-icon-box img { object-fit: contain; }
  .guide-header h1 { font-size: clamp(32px, 3.8vw, 44px); margin: 0; }
  .guide-badges { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 8px; }

  .tag {
    font-size: 12px;
    padding: 3px 8px;
    border-radius: 5px;
    background: var(--surface);
    color: var(--text-muted);
    font-weight: 500;
  }

  .prerequisites {
    display: flex;
    gap: 16px;
    padding: 18px 22px;
    margin-bottom: 36px;
    background: var(--surface-code);
    border: 1px solid var(--line-soft);
  }
  .prereq-icon { font-size: 18px; line-height: 1.4; color: var(--accent); }
  .prereq-content strong { color: var(--text); font-size: 14px; display: block; margin-bottom: 4px; }
  .prereq-content p { margin: 0 0 8px; font-size: 14px; color: var(--text-muted); line-height: 1.6; }
  .prereq-content a { color: var(--accent); font-size: 13px; font-weight: 500; }

  .step-card { margin-bottom: 44px; }
  .step-heading { display: flex; gap: 14px; margin-bottom: 16px; align-items: flex-start; }
  .step-badge {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--surface);
    color: var(--accent);
    font-size: 14px;
    font-weight: 600;
    flex-shrink: 0;
    border: 1px solid var(--line);
  }
  .step-heading h2 { font-size: 20px; margin: 0 0 4px; font-weight: 600; }
  .step-heading p { margin: 0; color: var(--text-muted); font-size: 15px; line-height: 1.6; }

  .code-panel { overflow: hidden; }
  .panel-title { display: inline-flex; align-items: center; gap: 8px; font-weight: 500; font-size: 13px; }
  .code-panel :global(pre) {
    background: var(--surface-code) !important;
    margin: 0;
    padding: 20px 24px;
    border-radius: 0;
    font-size: 14px;
    line-height: 1.6;
    overflow-x: auto;
  }
  .code-panel .panel-body { padding: 14px 20px; background: var(--surface); }
  .panel-body p { margin: 0; }

  .table-panel { overflow: hidden; }
  .risk-table { width: 100%; }
  .risk-table th { padding: 12px 18px; font-size: 13px; }
  .risk-table td { padding: 12px 18px; font-size: 14px; }
  .table-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 18px;
    background: var(--surface-header);
    font-size: 13px;
    color: var(--text-muted);
    border-top: 1px solid var(--line-soft);
  }
  .table-footer a { color: var(--accent); font-weight: 500; }

  .catalog-guide-panel { overflow: hidden; }
  .catalog-guide { padding: 24px 28px; }
  .catalog-guide :global(h2) { font-size: 20px; margin: 0 0 12px; }
  .catalog-guide :global(h2:not(:first-child)) { margin-top: 24px; }
  .catalog-guide :global(p) { font-size: 15px; line-height: 1.7; color: var(--text-muted); margin-bottom: 14px; }
  .catalog-guide :global(p:last-child) { margin-bottom: 0; }
  .catalog-guide :global(a) { color: var(--accent); }
  .catalog-guide :global(pre) {
    background: var(--surface-code) !important;
    padding: 16px 20px;
    border-radius: 8px;
    margin-block: 16px;
    overflow-x: auto;
  }
  .catalog-guide :global(code) { overflow-wrap: anywhere; }

  .replay-callout {
    display: flex;
    gap: 16px;
    padding: 18px 22px;
    background: var(--surface);
    margin-top: 36px;
    margin-bottom: 36px;
    align-items: flex-start;
  }
  .replay-callout-icon { color: var(--accent); flex-shrink: 0; margin-top: 2px; }
  .replay-callout-text strong { display: block; color: var(--text); font-size: 14px; margin-bottom: 4px; }
  .replay-callout-text span { color: var(--text-muted); font-size: 14px; line-height: 1.6; }
  .replay-callout-text a { color: var(--accent); }

  .page-actions { display: flex; gap: 14px; }

  @media (max-width: 680px) {
    .guide-header-top { flex-direction: column; align-items: flex-start; gap: 14px; }
    .table-footer { flex-direction: column; align-items: flex-start; gap: 8px; }
    .page-actions { flex-direction: column; }
    .page-actions .btn { width: 100%; justify-content: center; }
  }
</style>
