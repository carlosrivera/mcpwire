---
import Base from '../../layouts/Base.astro';
import CopyButton from '../../components/CopyButton.astro';
import { Code } from 'astro:components';
import servers from '../../data/servers';
export function getStaticPaths() {
  return servers.map((server) => ({ params:{slug:server.slug}, props:{server} }));
}
const s = Astro.props.server;
const defaults = s.tools.filter((tool) => s.defaults.allow.includes(tool.name));
const guides = import.meta.glob('../../../../catalog/*/guide.md', {eager:true});
const Guide = (guides[`../../../../catalog/${s.slug}/guide.md`] as {Content?: any} | undefined)?.Content;
if (!Guide) throw new Error(`Missing catalog guide for ${s.slug}`);
const caution = s.tools.filter((tool) => !s.defaults.allow.includes(tool.name) && tool.risk !== 'high');
const high = s.tools.filter((tool) => !s.defaults.allow.includes(tool.name) && tool.risk === 'high');
const shareCmd = ['npx -y @mcpwire/cli share',`--allow "${defaults.map((tool) => tool.name).join(',')}"`,`${s.defaults.redactSecrets ? '--redact-secrets ' : ''}--ttl ${s.defaults.ttl}`,`-- ${s.command}`].join(' \\\n  ');
const guestJson = JSON.stringify({mcpServers:{[`teleported-${s.slug}`]:{command:'npx',args:['-y','@mcpwire/cli','join','wire://<TICKET_FROM_HOST_BANNER>']}}},null,2);
const title = `Share ${s.name} MCP tools — MCPWire`;
const description = `Set up ${s.name} with MCPWire. Review tool access and copy a sharing command with an explicit allowlist, recognized-secret redaction, and a session expiry.`;
---
<Base title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'HowTo',name:title,description,tool:[{'@type':'HowToTool',name:'mcpwire'}],step:[{'@type':'HowToStep',name:'Start the host session',text:shareCmd},{'@type':'HowToStep',name:'Share the session ticket privately'},{'@type':'HowToStep',name:'Configure the teammate’s MCP client',text:guestJson}]})} />
  <section class="section">
    <div class="wrap">
      <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/teleport">Server guides</a><span aria-hidden="true">/</span><span>{s.name}</span></nav>
      <div class="page-head">
        <div class="eyebrow">{s.category} · {s.source} server</div>
        <div class="guide-title"><img src={s.icon} alt="" width="46" height="46" /><h1>Share {s.name} tools.</h1></div>
        <p class="page-intro">Run {s.name} on your machine and connect a teammate’s agent to selected tools. Review the access list below before starting your session.</p>
      </div>
      <div class="guide-stats" aria-label="Guide summary">
        <div class="stat"><strong>{defaults.length}</strong><span>Default tools</span></div>
        <div class="stat"><strong>{caution.length}</strong><span>Review first</span></div>
        <div class="stat"><strong>{high.length}</strong><span>Restricted tools</span></div>
        <div class="stat"><strong>{s.defaults.ttl}</strong><span>Session expiry</span></div>
      </div>
      {(s.requirements || s.docs) && <aside class="card prerequisites"><h2>Before you start</h2>{s.requirements && <p>{s.requirements}</p>}{s.docs && <a href={s.docs} target="_blank" rel="noopener noreferrer">Server setup and tool reference <span aria-hidden="true">↗</span></a>}</aside>}
      <div class="guide-columns">
        <div class="guide-commands">
          <div class="panel">
            <div class="panel-head"><span>On your machine · Terminal</span><CopyButton text={shareCmd} label="Copy host command" /></div>
            <Code code={shareCmd} lang="bash" theme="github-dark-dimmed" />
            <div class="panel-body"><p class="faint">This command exposes the {defaults.length} default tools, {s.defaults.redactSecrets ? 'enables pattern-based secret redaction, and ' : ''}ends the session after {s.defaults.ttl}. Add <code class="inline">--confirm</code> for interactive approvals or <code class="inline">--max-calls 20</code> for a call budget.</p></div>
          </div>
          <div class="panel">
            <div class="panel-head"><span>On their machine · MCP client</span><CopyButton text={guestJson} label="Copy guest config template" /></div>
            <Code code={guestJson} lang="json" theme="github-dark-dimmed" />
            <div class="panel-body"><p class="faint">Use the config printed by your host. The template above needs your session ticket, which can be reused while the host session is running. Share it privately.</p></div>
          </div>
        </div>
        <div class="panel">
          <div class="panel-head">Tool access · {s.name}</div>
          <div class="table-scroll" role="region" aria-label={`${s.name} tool access`} tabindex="0">
            <table class="tbl risk-table"><thead><tr><th>Tool</th><th>Access</th><th>Notes</th></tr></thead><tbody>{s.tools.map((tool) => <tr><td><code>{tool.name}</code></td><td><span class:list={['badge',s.defaults.allow.includes(tool.name) ? 'safe' : tool.risk === 'high' ? 'risk' : 'warn']}>{s.defaults.allow.includes(tool.name) ? 'Default' : tool.risk === 'high' ? 'Restricted' : 'Review'}</span></td><td class="dim">{tool.note}</td></tr>)}</tbody></table>
          </div>
        </div>
      </div>
      <section class="catalog-guide card"><Guide /></section>
      <div class="grid cols-3 guide-notes">
        <article class="card"><h2>Keep setup on your machine.</h2><p>Your teammate uses the shared tools through MCPWire. They don’t need to install this server or configure its API keys.</p></article>
        <article class="card"><h2>Review the session.</h2><p>Add <code class="inline">--record session.wirelog</code> to save a local log, then open it in the <a href="/replay">session replay viewer</a>.</p></article>
        <article class="card"><h2>Choose their access.</h2><p>Only allowlisted tools appear in their client. Requests for unlisted tools are rejected before reaching your MCP server.</p></article>
      </div>
      <div class="guide-faq">
        <details><summary>What happens when their agent calls a blocked tool?</summary><p>The request is rejected before it reaches your MCP server. MCPWire returns a JSON-RPC error with code <code class="inline">-32601</code> and logs the blocked attempt.</p></details>
        <details><summary>Can I add tools marked for review?</summary><p>Add the tool names to <code class="inline">--allow</code>. Use <code class="inline">--confirm</code> to approve calls in your terminal. You can allow or deny a call, or approve that tool for the remaining session.</p></details>
        <details><summary>How does the connection work?</summary><p>MCPWire uses the public Hyperswarm DHT for discovery and attempts a Noise-encrypted peer connection. Connectivity depends on both networks; restrictive NAT or firewall rules can prevent a connection.</p></details>
      </div>
      <div class="page-actions"><a class="btn ghost" href="/teleport">← All server guides</a><a class="btn" href="/builder">Open command builder <span aria-hidden="true">→</span></a></div>
    </div>
  </section>
</Base>
<style>
  .breadcrumbs { display:flex; gap:12px; color:var(--text-faint); font-size:14px; margin-bottom:32px; }
  .breadcrumbs a:hover { color:var(--accent); }
  .guide-title { display:flex; align-items:center; gap:19px; margin-bottom:18px; }
  .guide-title img { object-fit:contain; flex-shrink:0; }
  .guide-title h1 { margin:0; }
  .guide-stats { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:16px; margin-bottom:28px; }
  .stat { display:flex; flex-direction:column; gap:5px; padding:22px; border-radius:12px; background:var(--surface); box-shadow:var(--shadow-sm); }
  .stat strong { font-size:28px; font-weight:550; letter-spacing:-.03em; }
  .stat:first-child strong { color:var(--accent); }
  .stat span { color:var(--text-muted); font-size:14px; }
  .prerequisites { margin-bottom:28px; }
  .prerequisites h2 { font-size:19px; margin-bottom:10px; }
  .prerequisites p { font-size:15px; }
  .prerequisites a { display:inline-flex; gap:12px; color:var(--accent); font-size:14px; margin-top:14px; }
  .guide-columns { display:grid; grid-template-columns:1fr 1fr; gap:24px; align-items:start; }
  .guide-columns > * { min-width:0; }
  .guide-commands { display:flex; flex-direction:column; gap:24px; }
  .guide-commands :global(pre) { background:var(--surface-code) !important; border-radius:0; white-space:pre-wrap; overflow-wrap:anywhere; }
  .guide-commands .panel-body { padding-top:12px; }
  .panel-body p { margin:0; }
  .risk-table { min-width:500px; }
  .catalog-guide { margin-top:32px; }
  .catalog-guide :global(h2) { font-size:24px; }
  .catalog-guide :global(p) { font-size:16px; margin-bottom:16px; }
  .catalog-guide :global(p:last-child) { margin-bottom:0; }
  .catalog-guide :global(a) { color:var(--accent); }
  .catalog-guide :global(pre) { margin-block:20px; }
  .catalog-guide :global(code) { overflow-wrap:anywhere; }
  .guide-notes { margin-top:32px; }
  .guide-notes h2 { font-size:20px; }
  .guide-notes a { color:var(--accent); }
  .guide-faq { margin-top:36px; display:flex; flex-direction:column; gap:12px; }
  .guide-faq details { background:var(--surface); border-radius:12px; padding:20px 24px; box-shadow:var(--shadow-sm); }
  .guide-faq summary { cursor:pointer; font-size:16px; font-weight:500; }
  .guide-faq p { color:var(--text-muted); margin:14px 0 0; max-width:850px; }
  @media(max-width:1000px) { .guide-columns { grid-template-columns:1fr; } }
  @media(max-width:680px) { .guide-stats { grid-template-columns:repeat(2,minmax(0,1fr)); gap:12px; } .stat { padding:18px; } .guide-title { gap:14px; align-items:flex-start; } .guide-title img { width:36px; height:36px; margin-top:4px; } }
</style>
